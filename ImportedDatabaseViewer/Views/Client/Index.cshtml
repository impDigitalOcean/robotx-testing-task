@model ImportedDatabaseViewer.Services.ClientRepository.PagedData

<table class="table">

    <tr>
        <th>CardCode</th>
        <th>LastName</th>
        <th>FirstName</th>
        <th>SurName</th>
        <th>PhoneMobile</th>
        <th>Email</th>
        <th>GenderId</th>
        <th>Birthday</th>
        <th>City</th>
        <th>Pincode</th>
        <th>Bonus</th>
        <th>Turnover</th>
        <th>Действия</th>
    </tr>

    @foreach (Client client in Model.clients)
    {
        <tr>
            <th>@client.CardCode</th>
            <th>@client.LastName</th>
            <th>@client.FirstName</th>
            <th>@client.SurName</th>
            <th>@client.PhoneMobile</th>
            <th>@client.Email</th>
            <th>@client.GenderId</th>
            <th>@client.Birthday</th>
            <th>@client.City</th>
            <th>@client.Pincode</th>
            <th>@client.Bonus</th>
            <th>@client.Turnover</th>
            <th><a asp-action="Edit" asp-route-cardcode="@client.CardCode" asp-route-page="@Model.page">Редактировать</a></th>
        </tr>
    }
</table>
<div style="margin-bottom: 10px;"></div>
<p>Всего: @Model.total записей</p>
@if(Model.page>1)
{
    <a href="/client?page=@(Model.page-1)">Предыдущая страница</a>
}

@if (Model.total / 20 > Model.page)
{
    <a href="/client?page=@(Model.page+1)">Следующая страница</a>
}